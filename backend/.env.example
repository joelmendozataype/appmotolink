# Copiar a .env (no versionado) y ajustar para producción.
# En desarrollo, sin .env, settings.py usa los defaults seguros del código.

DJANGO_SECRET_KEY=cambia-esta-clave-por-una-secreta-y-unica-en-produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio.com,127.0.0.1

# --- Firestore ---------------------------------------------------------
# Backend de datos: 'firestore' (normal) o 'memory' (tests / demo offline).
MOTOLINK_DB_BACKEND=firestore

# Id del proyecto de Firebase (el mismo que aparece en google-services.json).
FIREBASE_PROJECT_ID=motolink-cff52

# Ruta ABSOLUTA al JSON de la cuenta de servicio. Es un secreto: guardarlo
# fuera del repositorio. Se descarga en la consola de Firebase >
# Configuración del proyecto > Cuentas de servicio > Generar nueva clave.
FIREBASE_CREDENTIALS_FILE=C:/ruta/fuera/del/repo/motolink-service-account.json
