# Copiar a .env (no versionado) y ajustar.

# --- Django ------------------------------------------------------------
# Obligatoria si DJANGO_DEBUG=False. Las sesiones se firman con esta clave,
# así que quien la conozca puede fabricarse una sesión de administrador.
# Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio.com,127.0.0.1

# Orígenes web autorizados, separados por coma. Obligatorio con
# DJANGO_DEBUG=False. La app Android no manda cabecera Origin, así que
# esto solo afecta a la versión web.
DJANGO_CORS_ORIGINS=https://tu-dominio.com

# Redirección forzada a HTTPS. Ponlo en False solo si el proxy de delante
# ya la hace, para no provocar un bucle de redirecciones.
DJANGO_SSL_REDIRECT=True

# HSTS en segundos. Empieza bajo (3600) y súbelo a 31536000 cuando
# confirmes que el dominio sirve HTTPS de forma estable: es difícil de
# revertir, los navegadores lo recuerdan.
DJANGO_HSTS_SECONDS=3600

# --- Firestore ---------------------------------------------------------
# Backend de datos: 'firestore' (normal) o 'memory' (tests / demo offline).
MOTOLINK_DB_BACKEND=firestore

# Id del proyecto de Firebase (el mismo que aparece en google-services.json).
FIREBASE_PROJECT_ID=motolink-cff52

# Ruta ABSOLUTA al JSON de la cuenta de servicio. Es un secreto: guardarlo
# fuera del repositorio. Se descarga en la consola de Firebase >
# Configuración del proyecto > Cuentas de servicio > Generar nueva clave.
FIREBASE_CREDENTIALS_FILE=/ruta/fuera/del/repo/motolink-service-account.json
